NODE_ENV=development
PORT=5002
HOST=0.0.0.0

# Container-to-container: usar el nombre del contenedor (rebusque-db) como host.
# Local (fuera de contenedor, ej. para drizzle-kit pull): usar 127.0.0.1:5432.
DATABASE_URL=postgresql://rebusque:change-me@rebusque-db:5432/rebusque

SESSION_TTL_HOURS=12

# Origenes permitidos por CORS, separados por coma (sin espacios necesarios).
CORS_ALLOWED_ORIGINS=http://localhost:3006,http://127.0.0.1:3006,https://platform.elrebusque.cl,https://elrebusque.cl,https://www.elrebusque.cl
